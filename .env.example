# ==========================================
# Studio Ops Copilot Configuration
# ==========================================

# ------------------------------------------
# Google Cloud AI (Strict Runtime Constraint: Gemini Only)
# Get your FREE API key (no Google Cloud billing account or credit card needed):
# https://aistudio.google.com/app/api-keys
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Grafana MCP server (real Model Context Protocol connection)
# ------------------------------------------
# Option A: Connect via SSE to a hosted Grafana Cloud MCP endpoint (if available on your plan)
# GRAFANA_MCP_SSE_URL=https://your-instance.grafana.net/mcp

# Option B: Run bundled mcp-grafana binary directly (no Docker-in-Docker needed)
GRAFANA_MCP_COMMAND=/usr/local/bin/mcp-grafana
GRAFANA_MCP_ARGS=
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_service_account_token

# ------------------------------------------
# Optional: Grafana Prometheus Remote Write
# ------------------------------------------
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=123456
GRAFANA_PROMETHEUS_TOKEN=glc_your_token_here

# ------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------
PORT=8080
HOST=0.0.0.0
SIMULATOR_TICK_SECONDS=2.0
