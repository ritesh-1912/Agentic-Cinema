# ==========================================
# Studio Ops Copilot Configuration
# ==========================================

# ------------------------------------------
# Google Cloud AI (Strict Runtime Constraint: Gemini Only)
# Get your API key: https://aistudio.google.com/app/api-keys
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Grafana MCP server (real Model Context Protocol connection, not REST)
# ------------------------------------------
GRAFANA_MCP_COMMAND=docker
GRAFANA_MCP_ARGS=run -i --rm -e GRAFANA_URL -e GRAFANA_SERVICE_ACCOUNT_TOKEN mcp/grafana
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=your_service_account_token

# ------------------------------------------
# Optional: Grafana Prometheus Remote Write
# ------------------------------------------
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=123456
GRAFANA_PROMETHEUS_TOKEN=glc_your_token_here

# ------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------
PORT=8080
HOST=0.0.0.0
SIMULATOR_TICK_SECONDS=2.0
