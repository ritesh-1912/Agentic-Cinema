# ==========================================
# Studio Ops Copilot Configuration
# ==========================================

# Google Cloud AI / Gemini Configuration (Required for live Gemini models)
# Get your API key from Google AI Studio: https://aistudio.google.com/app/api-keys
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Grafana Cloud Configuration (Required for live Grafana MCP integration)
# URL of your Grafana Cloud instance, e.g. https://myorg.grafana.net
GRAFANA_URL=https://your-instance.grafana.net
# Grafana Service Account Token with Viewer or Editor permissions
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_grafana_service_account_token_here

# Optional: Grafana Prometheus Remote Write (for streaming synthetic studio metrics to Grafana Cloud)
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=123456
GRAFANA_PROMETHEUS_TOKEN=glc_your_token_here

# Server Configuration
PORT=8080
HOST=0.0.0.0
SIMULATOR_TICK_SECONDS=2
