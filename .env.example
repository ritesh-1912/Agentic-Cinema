# ==========================================
# Studio Ops Copilot Configuration
# ==========================================

# ------------------------------------------
# Google Cloud AI (Strict Runtime Constraint: Gemini Only)
# Get your API key: https://aistudio.google.com/app/api-keys
# ------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------
# Grafana Cloud MCP Server Configuration
# Transport options: 'stdio' (Docker / local binary) or 'sse' (Hosted MCP endpoint)
# ------------------------------------------
GRAFANA_MCP_TRANSPORT=stdio

# Option A: Stdio Subprocess (default - runs official 'grafana/mcp-grafana' container)
GRAFANA_URL=https://your-instance.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_grafana_service_account_token_here
GRAFANA_MCP_COMMAND=docker
# Optional custom args (defaults to: run -i --rm -e GRAFANA_URL=... -e GRAFANA_SERVICE_ACCOUNT_TOKEN=... grafana/mcp-grafana -t stdio)
# GRAFANA_MCP_ARGS=run -i --rm -e GRAFANA_URL=... -e GRAFANA_SERVICE_ACCOUNT_TOKEN=... grafana/mcp-grafana -t stdio

# Option B: Hosted SSE Endpoint (Grafana Cloud MCP over SSE)
# GRAFANA_MCP_TRANSPORT=sse
# GRAFANA_MCP_SSE_URL=https://your-instance.grafana.net/api/mcp
# GRAFANA_SERVICE_ACCOUNT_TOKEN=glsa_your_grafana_service_account_token_here

# ------------------------------------------
# Optional: Grafana Prometheus Remote Write
# ------------------------------------------
GRAFANA_PROMETHEUS_URL=https://prometheus-prod-01-eu-west-0.grafana.net/api/prom/push
GRAFANA_PROMETHEUS_USER=123456
GRAFANA_PROMETHEUS_TOKEN=glc_your_token_here

# ------------------------------------------
# Server & Runtime Configuration
# ------------------------------------------
PORT=8080
HOST=0.0.0.0
SIMULATOR_TICK_SECONDS=2.0
